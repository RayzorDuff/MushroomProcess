    {
      "name": "Validate list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "if(String($env.MP_COMMERCE_FULFILLMENT_ENABLED||'')!=='true') throw new Error('Woo fulfillment disabled');\nconst p=$json.body||$json;p.provider='woocommerce';p.site_key='danks.store';\nif(p.external_order_id && !/^[1-9][0-9]*$/.test(String(p.external_order_id))) throw new Error('Numeric Woo order ID required');\nif(p.product_code) {\n const product=decodeURIComponent(String(p.product_code)).match(/(?:PROD|LOT)-[A-Za-z0-9-]+/);\n if(!product) throw new Error('Scan a Product or sellable whole Lot QR.');\n p.product_code=product[0];\n}\nreturn [{json:{payload:Buffer.from(JSON.stringify(p)).toString('base64'),order_id:String(p.external_order_id||'')}}];"
      },
      "id": "5104a153-405e-4e6b-af1e-954f4aa61fe3",
      "position": [
        240,
        30
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT coalesce(jsonb_agg(jsonb_build_object('order_id',o.external_order_id,'site_key',o.site_key,\n 'status',o.status,'confirmed',o.reservation_confirmed,'fulfilled',o.fulfilled,'lines',o.snapshot->'lines',\n 'packages',coalesce((SELECT jsonb_agg(jsonb_build_object('reference',k.reference,'state',k.state,'method',k.method,'tracking',k.tracking))\n FROM mp_commerce_packages k WHERE (k.provider,k.site_key,k.external_order_id)=(o.provider,o.site_key,o.external_order_id)),'[]'::jsonb)\n ) ORDER BY o.external_order_id),'[]'::jsonb) AS orders FROM mp_commerce_orders o\n WHERE o.provider='woocommerce' AND o.site_key='danks.store' AND o.reservation_confirmed",
        "options": {}
      },
      "id": "8cae7baf-aacc-4603-992e-a4721becae12",
      "name": "Commerce list",
      "type": "n8n-nodes-base.postgres",
