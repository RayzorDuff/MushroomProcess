    {
      "id": "node-016-pgsql-read-reservation-adjus",
      "name": "PGSQL - Read Reservation-adjusted MP Inventory",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -560,
        720
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.ecommerce_id, c.erp_item_code, c.provider, c.site_key, c.external_sku, c.external_product_id, c.external_variation_id, c.available_from_products, c.available_from_lots, c.desired_quantity AS gross_quantity, r.available_quantity AS desired_quantity FROM public.mp_ecommerce_catalog_inventory() c JOIN public.mp_commerce_inventory() r USING (ecommerce_id) ORDER BY c.ecommerce_id;",
        "options": {}
      },
