    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $('Code - Resolve Ecwid SKU Target').item.json;\nconst reservedUpc = String($json.reserved_upc || '').trim();\n\nif (!reservedUpc) {\n  throw new Error(`PostgreSQL did not reserve a UPC for ecommerce row ${row.ecommerce_id}`);\n}\n\nreturn {\n  json: {\n    ...row,\n    ecwid_upc: reservedUpc,\n    needs_upc_reservation: false,\n    needs_upc_write: true,\n  },\n};"
      },
      "id": "de1d25b5-11e6-4e98-b66d-c174ea6cf3d6",
      "name": "Code - Attach Reserved UPC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        64
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const quantity = Math.max(0, Math.trunc(Number($json.desired_quantity || 0)));\nconst productId = String($json.ecwid_product_id || '').trim();\nconst variationId = String($json.ecwid_variation_id || '').trim();\n\nif (!productId) {\n  throw new Error(`Ecwid product id is missing for ecommerce row ${$json.ecommerce_id}`);\n}\n\nconst body = {\n  quantity,\n  unlimited: false,\n};\n\nif ($json.needs_upc_write && $json.ecwid_upc) {\n  body.attributes = [\n    {\n      name: 'UPC',\n      value: String($json.ecwid_upc),\n    },\n  ];\n}\n\nreturn {\n  json: {\n    ...$json,\n    desired_quantity: quantity,\n    update_url: variationId\n      ? `https://app.ecwid.com/api/v3/${$env.ECWID_STORE_ID}/products/${productId}/combinations/${variationId}`\n      : `https://app.ecwid.com/api/v3/${$env.ECWID_STORE_ID}/products/${productId}`,\n    update_body: body,\n  },\n};"
      },
