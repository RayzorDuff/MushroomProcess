      "id": "0ee15b9f-593e-4fb2-9c96-ba40f5752694",
      "name": "HTTP - Find Ecwid Product by SKU",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -560,
        240
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $('PGSQL - Load Ecwid Catalog Sync Candidates').item.json;\nconst response = $json || {};\nconst sku = String(row.external_sku || '').trim();\n\nif (response.error) {\n  return {\n    json: {\n      ...row,\n      ecwid_target_found: false,\n      should_update: false,\n      skip_reason: `Ecwid product lookup failed: ${response.error.message || response.error}`,\n    },\n  };\n}\n\nconst items = Array.isArray(response.items) ? response.items : [];\nlet product = null;\nlet variation = null;\n\nfor (const candidate of items) {\n  if (String(candidate?.sku || '').trim() === sku) {\n    product = candidate;\n    variation = null;\n    break;\n  }\n\n  const exactVariation = Array.isArray(candidate?.variations)\n    ? candidate.variations.find((entry) => String(entry?.sku || '').trim() === sku)\n    : null;\n\n  if (exactVariation) {\n    product = candidate;\n    variation = exactVariation;\n    break;\n  }\n}\n\nif (!product) {\n  return {\n    json: {\n      ...row,\n      ecwid_target_found: false,\n      should_update: false,\n      skip_reason: `No exact Ecwid product or variation found for SKU ${sku}`,\n      ecwid_search_result_count: items.length,\n    },\n  };\n}\n\nconst target = variation || product;\nconst ecwidUpcAttribute = Array.isArray(target?.attributes)\n  ? target.attributes.find((entry) => String(entry?.name || '').trim().toUpperCase() === 'UPC')\n  : null;\n\nconst targetUpc = String(ecwidUpcAttribute?.value || '').trim() || null;\nconst databaseUpc = String(row.upc || '').trim() || null;\nconst chosenUpc = databaseUpc || targetUpc || null;\nconst priceValue = Number(target?.price);\nconst categoryId = Array.isArray(product?.categoryIds) && product.categoryIds.length\n  ? String(product.categoryIds[0])\n  : null;\n\nreturn {\n  json: {\n    ...row,\n    ecwid_target_found: true,\n    should_update: true,\n    ecwid_product_id: product?.id != null ? String(product.id) : null,\n    ecwid_variation_id: variation?.id != null ? String(variation.id) : null,\n    ecwid_price: Number.isFinite(priceValue) ? priceValue : null,\n    ecwid_url: product?.url ? String(product.url) : null,\n    ecwid_category: categoryId,\n    ecwid_target_upc: targetUpc,\n    ecwid_upc: chosenUpc,\n    needs_upc_reservation: !chosenUpc,\n    needs_upc_write: Boolean(chosenUpc && !targetUpc),\n    upc_mismatch: Boolean(databaseUpc && targetUpc && databaseUpc !== targetUpc),\n    ecwid_search_result_count: items.length,\n  },\n};"
      },
