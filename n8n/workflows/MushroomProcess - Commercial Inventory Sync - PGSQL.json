    {
      "id": "node-024-code-verify-woo-ownership-an",
      "name": "Code - Verify Woo Ownership and Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        880
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Code - Verify Reviewed Woo Mapping').item.json;\nconst product = $json || {};\nconst meta=(product.meta_data||[]).filter(m=>m.key==='_rootedops_source_key');\nif(product.id!==src.woo_id || product.sku!==src.woo_sku ||\n product.type!=='simple' || product.status!=='draft' ||\n product.catalog_visibility!=='hidden' || product.manage_stock!==true ||\n meta.length!==1 || meta[0].value!==src.source_key)\n throw new Error('Woo product identity, ownership, visibility or managed-stock mismatch');\nreturn {json:{...src,previous_quantity:product.stock_quantity,\n  should_write:product.stock_quantity!==src.desired_quantity}};"
      }
    },
    {
      "id": "node-025-if-woo-quantity-changed-",
      "name": "IF - Woo Quantity Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        880
      ],
      "parameters": {
        "conditions": {
          "options": {
