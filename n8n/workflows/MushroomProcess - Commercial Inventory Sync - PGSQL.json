    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $('Code - Prepare Ecwid Update').item.json;\n\nconst payload = {\n  ecommerce_id: row.ecommerce_id,\n  provider: 'ecwid',\n  site_key: row.site_key || 'dank_mushrooms',\n  external_sku: row.external_sku,\n  external_product_id: row.ecwid_product_id || null,\n  external_variation_id: row.ecwid_variation_id || null,\n  external_category: row.ecwid_category || null,\n  external_price: row.ecwid_price,\n  external_stock: row.desired_quantity,\n  public_url: row.ecwid_url || null,\n  upc: row.ecwid_upc || null,\n};\n\nreturn {\n  json: {\n    ecommerce_id: row.ecommerce_id,\n    external_sku: row.external_sku,\n    desired_quantity: row.desired_quantity,\n    upc_mismatch: row.upc_mismatch === true,\n    payload_base64: Buffer.from(JSON.stringify(payload), 'utf8').toString('base64'),\n  },\n};"
      },
