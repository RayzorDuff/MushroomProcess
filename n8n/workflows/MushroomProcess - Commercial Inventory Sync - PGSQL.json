      "id": "fbdca761-efa9-4487-adeb-d89c556835aa",
      "name": "HTTP - Update Ecwid Quantity and UPC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1120,
        176
