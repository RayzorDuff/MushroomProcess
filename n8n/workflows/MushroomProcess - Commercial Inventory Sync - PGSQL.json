    {
      "id": "node-017-code-validate-mp-inventory-s",
      "name": "Code - Validate MP Inventory Snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        720
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $json;\nconst q = Number(row.desired_quantity);\nconst id = Number(row.ecommerce_id);\nif (!Number.isSafeInteger(id) || id <= 0 || !Number.isSafeInteger(q) || q < 0) throw new Error('Invalid MP ecommerce ID or inventory count');\nconst code = String(row.erp_item_code || '').trim();\nconst provider = String(row.provider || '').trim().toLowerCase();\nconst site = String(row.site_key || '').trim();\nif (!provider || !site) throw new Error('Missing MP provider/site identity');\nreturn {json:{...row,desired_quantity:q,ecommerce_id:id,\n  observed_at: new Date().toISOString(),\n  inventory_authority:'mushroomprocess',\n  mapping_valid:Boolean(code && String(row.external_sku || '').trim()),\n  erp_payload:{erp_item_code:code,ecommerce_id:id,desired_quantity:q,\n    observed_at:new Date().toISOString(),provider,site_key:site}\n}};"
      }
    },
