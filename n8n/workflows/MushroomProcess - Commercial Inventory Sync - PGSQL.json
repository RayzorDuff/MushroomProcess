    {
      "id": "node-022-code-verify-reviewed-woo-map",
      "name": "Code - Verify Reviewed Woo Mapping",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        880
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source = $('Code - Validate MP Inventory Snapshot').item.json;\nconst cat = $json.message || {};\nconst item = String(source.erp_item_code || '');\nif(cat.item?.item_code !== item || cat.item?.disabled) throw new Error('ERP Item identity/disabled mismatch');\nconst base = String($env.MP_SYNC_WOO_BASE_URL || '');\nif(base !== 'https://shop-test.danks.store') throw new Error('Woo sync restricted to exact staging shop');\nconst mappings = (cat.mappings || []).filter(m =>\n  String(m.provider).toLowerCase()==='woocommerce' &&\n  String(m.site_key)==='shop-test.danks.store' &&\n  String(m.mushroomprocess_ecommerce_id)===String(source.ecommerce_id) &&\n  String(m.external_sku)===String(source.external_sku) &&\n  (m.sync_enabled===1 || m.sync_enabled===true));\nif(mappings.length !== 1) throw new Error('Exact approved Woo mapping absent/ambiguous');\nconst m = mappings[0];\nif(String(m.external_variation_id || '') !== '') throw new Error('Variation stock is not enabled by this first adapter');\nif(!/^[1-9][0-9]*$/.test(String(m.external_product_id))) throw new Error('Invalid Woo product ID');\nif(cat.content?.publication_status !== 'Draft') throw new Error('Only draft staging content may be updated');\nreturn {json:{...source,woo_id:Number(m.external_product_id),woo_url:base,\n  woo_sku:String(m.external_sku),source_key:String(cat.content.source_key || '')}};"
      }
    },
    {
