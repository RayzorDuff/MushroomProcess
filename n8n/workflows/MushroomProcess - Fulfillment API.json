      ],
      "parameters": {
        "jsCode": "const req=$('Code - Parse Product Search').first().json; const prodResp=$('HTTP - List Products Airtable').first().json||{}; const locResp=$('HTTP - List Locations Airtable').first().json||{}; const shipped=((locResp.records||[]).find(r=>String(r.fields?.name||'')===String($env.AIRTABLE_SHIPPED_LOCATION_NAME||'Shipped'))||{}).id||''; const locMap=new Map((locResp.records||[]).map(r=>[r.id, String(r.fields?.name||'')])); const rows=Array.isArray(prodResp.records)?prodResp.records:[]; const q=req.query; const products=[]; for(const rec of rows){ const f=rec.fields||{}; const locs=Array.isArray(f.storage_location)?f.storage_location:[]; if(shipped && locs.includes(shipped)) continue; const hay=[f.product_id,f.name_mat,f.item_category_mat,f.notes].filter(Boolean).join(' ').toLowerCase(); if(q && !hay.includes(q)) continue; products.push({airtable_record_id:rec.id, product_id:f.product_id||'', name_mat:f.name_mat||'', item_category_mat:f.item_category_mat||'', storage_location_name:locs.map(id=>locMap.get(id)||id).join(', '), notes:f.notes||''}); }\nreturn [{json:{ok:true, products:products.slice(0,100), count:products.length}}];"
