    {
      "parameters": {
        "jsCode": "const req = $('Code - Parse Product Search').first().json;\nconst prodResp = $('HTTP - List Products Airtable').first().json || {};\nconst locResp = $('HTTP - List Locations Airtable').first().json || {};\n\nconst excludedLocationNames = new Set(\n  ['Shipped', 'Consumed', 'Compost', 'Expired'].map(s => s.toLowerCase())\n);\n\nconst locRecords = Array.isArray(locResp.records) ? locResp.records : [];\nconst locMap = new Map(\n  locRecords.map(r => [r.id, String(r.fields?.name || '')])\n);\n\nconst excludedLocationIds = new Set(\n  locRecords\n    .filter(r => excludedLocationNames.has(String(r.fields?.name || '').toLowerCase()))\n    .map(r => r.id)\n);\n\nconst rows = Array.isArray(prodResp.records) ? prodResp.records : [];\nconst q = String(req.query || '').trim().toLowerCase();\n\nconst products = [];\n\nfor (const rec of rows) {\n  const f = rec.fields || {};\n  const locs = Array.isArray(f.storage_location) ? f.storage_location : [];\n\n  if (locs.some(id => excludedLocationIds.has(id))) continue;\n\n  const hay = [\n    f.product_id,\n    f.name_mat,\n    f.unit_size,\n    f.item_category_mat,\n    f.notes\n  ]\n    .filter(Boolean)\n    .join(' ')\n    .toLowerCase();\n\n  if (q && !hay.includes(q)) continue;\n\n  products.push({\n    airtable_record_id: rec.id,\n    product_id: f.product_id || '',\n    name_mat: f.name_mat || '',\n    unit_size: f.unit_size || '',    \n    item_category_mat: f.item_category_mat || '',\n    storage_location_name: locs.map(id => locMap.get(id) || id).join(', '),\n    notes: f.notes || ''\n  });\n}\n\nreturn [{\n  json: {\n    ok: true,\n    products: products.slice(0, 100),\n    count: products.length\n  }\n}];"
      },
