    {
      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\n\nif (!Array.isArray(data.fulfillmentProductSearchRecords)) {\n  data.fulfillmentProductSearchRecords = [];\n}\n\nconst pageRecords = Array.isArray($json.records) ? $json.records : [];\ndata.fulfillmentProductSearchRecords.push(...pageRecords);\n\nreturn [{\n  json: {\n    offset: $json.offset || '',\n    page_count: pageRecords.length,\n    accumulated_count: data.fulfillmentProductSearchRecords.length\n  }\n}];"
      },
