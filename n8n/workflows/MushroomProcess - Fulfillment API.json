    {
      "parameters": {
        "jsCode": "const req = $('Code - Parse Product Search').first().json;\nconst q = String(req.query || '').trim().toLowerCase();\nconst companyName = $env['BUSINESS_NAME'] || null;\n\nconst locResp = $('HTTP - List Locations Airtable').first().json || {};\nconst locRecords = Array.isArray(locResp.records) ? locResp.records : [];\nconst locMap = new Map(\n  locRecords.map(r => [r.id, String(r.fields?.name || '')])\n);\n\nconst inputs = $input.all();\nconst rows = inputs.flatMap(item => {\n  const records = item.json?.records;\n  return Array.isArray(records) ? records : [];\n});\n\nconst products = [];\n\nfor (const rec of rows) {\n  const f = rec.fields || {};\n\n  if (companyName && String(f.label_company_prod || '') !== companyName) continue;\n\n  const hay = [\n    f.product_id,\n    f.name_mat,\n    f.unit_size,\n    f.item_category_mat,\n    f.notes\n  ]\n    .filter(Boolean)\n    .join(' ')\n    .toLowerCase();\n\n  if (q && !hay.includes(q)) continue;\n\n  const locIds = Array.isArray(f.storage_location) ? f.storage_location : [];\n  const locNames = locIds.map(id => locMap.get(id) || id);\n\n  products.push({\n    airtable_record_id: rec.id,\n    product_id: f.product_id || '',\n    name_mat: f.name_mat || '',\n    unit_size: f.unit_size || '',\n    item_category_mat: f.item_category_mat || '',\n    storage_location: locIds,\n    storage_location_name: locNames.join(', '),\n    notes: f.notes || ''\n  });\n}\n\nreturn [{\n  json: {\n    ok: true,\n    page_count: inputs.length,\n    raw_record_count: rows.length,\n    products: products.slice(0, 100),\n    count: products.length\n  }\n}];"
      },
