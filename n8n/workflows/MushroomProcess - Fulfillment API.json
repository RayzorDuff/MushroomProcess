      "parameters": {
        "jsCode": "const req = $('Code - Parse List Request').first().json;\nconst rows = Array.isArray($json.records) ? $json.records : [];\nfunction dateKey(v,tz){ if(!v) return ''; const d=new Date(v); if(Number.isNaN(d.getTime())) return ''; const parts=new Intl.DateTimeFormat('en-CA',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(d); const m=Object.fromEntries(parts.map(p=>[p.type,p.value])); return `${m.year}-${m.month}-${m.day}`; }\nfunction localTime(v,tz){ if(!v) return ''; const d=new Date(v); if(Number.isNaN(d.getTime())) return ''; return new Intl.DateTimeFormat('en-US',{timeZone:tz,hour:'numeric',minute:'2-digit',second:'2-digit',hour12:true}).format(d); }\nfunction parseItems(s){ try{ const a=typeof s==='string'?JSON.parse(s):[]; return Array.isArray(a)?a:[];}catch(e){return [];} }\nfunction itemSummary(items){ return items.map(i=>`${i.name||i.nameTranslated?.en||'(unknown)'} x${Number(i.quantity||0)||0}`).join(', '); }\nconst out=[];\nfor(const rec of rows){ const f=rec.fields||{}; const items=parseItems(f.items_json); const requiredCount=items.reduce((n,i)=>n+(Number(i.quantity||0)||0),0); const linkedProducts=Array.isArray(f.products)?f.products:[]; const linkedCount=linkedProducts.length; const market=(f.payment_method==='Sell on the Go - Placed'); const ready = market ? String(f.clover_reconciliation_status||'')==='reconciled' : String(f.payment_status||'').toUpperCase()==='PAID'; const mode=req.mode||'all'; if(mode==='market' && !market) continue; if(mode==='web' && market) continue; if(!ready) continue; if(req.date && dateKey(f.order_date, req.timezone)!==req.date) continue; if(linkedCount>=requiredCount) continue; out.push({airtable_record_id:rec.id, order_ref:String(f.order_code||f.ecwid_order_id||f.order_number||''), order_number:f.order_number||null, order_date:f.order_date||null, order_date_local:localTime(f.order_date, req.timezone), customer_name:f.customer_name||'', payment_method:f.payment_method||'', payment_status:f.payment_status||'', clover_reconciliation_status:f.clover_reconciliation_status||'', payment_state: market ? (f.clover_reconciliation_status||'pending') : (f.payment_status||''), mode: market ? 'market' : 'web', linked_count:linkedCount, required_count:requiredCount, product_names:itemSummary(items)||'(none)', products_report:f.products_report||'', product_ids_report:f.product_ids_report||'', items, reconciliation_notes:f.reconciliation_notes||''}); }\nout.sort((a,b)=> String(a.order_date||'').localeCompare(String(b.order_date||'')));\nreturn [{json:{ok:true, orders:out, count:out.length}}];"
