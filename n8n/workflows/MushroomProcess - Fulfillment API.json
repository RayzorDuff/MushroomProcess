    },
    {
      "parameters": {
        "jsCode": "const req = $('Code - Parse Product Search').first().json;\nconst companyName = $env['BUSINESS_NAME'] || null;\nconst query = String(req.query || '').trim().toLowerCase();\n\nfunction formulaEscape(s) {\n  return String(s || '')\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/\"/g, '\\\\\"');\n}\n\nconst clauses = [];\n\nif (companyName) {\n  clauses.push(`{label_company_prod}=\"${formulaEscape(companyName)}\"`);\n}\n\n// Exclude by linked-record display names, not record IDs\nfor (const locName of ['Shipped', 'Consumed', 'Compost', 'Expired']) {\n  clauses.push(`NOT(FIND(\"${formulaEscape(locName.toLowerCase())}\", LOWER(ARRAYJOIN({storage_location}&\"\"))))`);\n}\n\nif (req.allow_search && query) {\n  clauses.push(`OR(\n    FIND(\"${formulaEscape(query)}\", LOWER({product_id}&\"\")),\n    FIND(\"${formulaEscape(query)}\", LOWER({name_mat}&\"\")),\n    FIND(\"${formulaEscape(query)}\", LOWER({unit_size}&\"\")),\n    FIND(\"${formulaEscape(query)}\", LOWER({item_category_mat}&\"\")),\n    FIND(\"${formulaEscape(query)}\", LOWER({notes}&\"\"))\n  )`);\n}\n\nconst filter_formula =\n  clauses.length === 1 ? clauses[0] : `AND(${clauses.join(',')})`;\n\nreturn [{\n  json: {\n    query,\n    allow_search: !!req.allow_search,\n    company_name: companyName,\n    filter_formula,\n    offset: ''\n  }\n}];"
      },
