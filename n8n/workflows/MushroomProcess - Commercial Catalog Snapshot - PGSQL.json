  ],
  "connections": {
    "Manual staging execution": {
      "main": [
        [
          {
            "node": "Read operational inventory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read operational inventory": {
      "main": [
        [
          {
            "node": "Validate ERP links",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
