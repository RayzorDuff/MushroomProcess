#DB_BACKEND defaults to Airtable
DB_BACKEND="Airtable"
#DB_BACKEND="NocoDB"

# -----------------------
# Multi-instance settings
# -----------------------
# Optional but recommended if running multiple daemons on the same machine.
# Each daemon should have a unique instance id (used for logs, locks, and job stamping).
DAEMON_INSTANCE_ID=default

# -----------------------
# Logging / verbosity
# -----------------------
# Levels: error, warn, info, debug, trace
LOG_LEVEL=info
# Set to true to force LOG_LEVEL=debug unless LOG_LEVEL is explicitly set
VERBOSE=false

# Write logs to file under LOG_DIR/<DAEMON_INSTANCE_ID>/ (recommended for NSSM services)
LOG_TO_FILE=true
LOG_FILE=daemon.log
MAX_LOG_BYTES=5242880
MAX_LOG_BACKUPS=5

# Also echo to console (useful when running interactively)
LOG_TO_CONSOLE=true

# Emit JSON log lines (good for log ingestion). If false, emits compact text lines.
LOG_JSON=false

# Heartbeat log interval in ms (0 disables). Uses DEBUG level.
HEARTBEAT_MS=60000

# -----------------------
# Queue routing
# -----------------------
#PRINT_DRY_RUN=true   # render PDFs, update statuses, skip physical printing

# Optional: route jobs by a field instead of relying on Airtable Views.
# If PRINT_TARGET_VALUE is set, the daemon will only process jobs where:
#   {PRINT_TARGET_FIELD} == PRINT_TARGET_VALUE
# Example values:
#   PRINT_TARGET_VALUE=TRAYS
#   PRINT_TARGET_VALUE=ZEBRA
PRINT_TARGET_FIELD=print_target
#PRINT_TARGET_VALUE=ZEBRA
#PRINT_TARGET_VALUE=TRAYS

#Extra Print query parameters
#AIRTABLE_EXTRA_FILTER_FORMULA=
#NOCODB_EXTRA_WHERE=

# Optional: only ONE daemon instance should print sterilizer sheets.
ENABLE_STERI_SHEETS=true

# Stable MushroomProcess QR resolver. Product and Lot labels encode the canonical
# PROD-/LOT- identifier through this endpoint instead of Airtable/ecommerce URLs.
# Leave unset to use the production default below.
QR_RESOLVER_BASE_URL=https://qr.danks.store/r

# -----------------------
# Printer locking
# -----------------------
# Locking (prevents two instances from printing to the same Windows printer at the same time)
LOCK_DIR=locks
PRINTER_LOCK_TIMEOUT_MS=60000
PRINTER_LOCK_RETRY_MS=250

# -----------------------
# Airtable
# -----------------------

AIRTABLE_API_KEY=pxxxxx
AIRTABLE_BASE_ID=appxxxxxx

# -----------------------
# NocoDB
# -----------------------
# For normal/internal NocoDB tables using the older v2 API:
#NOCODB_URL=http://localhost:8080
#NOCODB_API_TOKEN=your_token_here
#NOCODB_API_VERSION=v2

# For NocoDB external PostgreSQL sources using /api/v3/data/...:
#NOCODB_URL=https://nocodb.example.com
#NOCODB_API_TOKEN=your_token_here
#NOCODB_API_VERSION=v3
#NOCODB_BASE_ID=pgxxxxxxxxxxxxx
#NOCODB_AUTO_RESOLVE_IDS=true
#NOCODB_PAGE_SIZE=25
# Legacy aliases still accepted: NOCODB_SOURCE_ID, NOCODB_BASE_SOURCE_ID

# -----------------------
# Tables / views
# -----------------------
# Airtable and NocoDB v2 can usually use these names/slugs. They are also
# the daemon defaults, so leave them commented unless overriding them.
#PRINT_QUEUE_TABLE=print_queue
#STERILIZATION_RUNS_TABLE=sterilization_runs
#LOTS_TABLE=lots
#QUEUE_VIEW=Queue_All

# NocoDB v3 external PostgreSQL notes:
# - The daemon automatically resolves these logical names to NocoDB table IDs:
#     read queue: vc_print_queue
#     write queue: print_queue
#     sterilizer runs: vc_sterilization_runs (fallback sterilization_runs)
#     lots: vc_lots (fallback lots)
# - View IDs are optional and normally omitted.
# - Verify resolution without polling or printing:
#     node print-daemon.js --env-file .env --check-config
#
# Optional manual overrides. Names are accepted when auto-resolution is enabled;
# internal table IDs are required when NOCODB_AUTO_RESOLVE_IDS=false.
#PRINT_QUEUE_READ_TABLE=vc_print_queue
#PRINT_QUEUE_WRITE_TABLE=print_queue
#PRINT_QUEUE_WRITE_ID_FIELD=nocopk
#STERILIZATION_RUNS_TABLE=vc_sterilization_runs
#LOTS_TABLE=vc_lots
#
# Optional view filters/order. Do not leave placeholder values here.
#PRINT_QUEUE_READ_VIEW_ID=
#STERILIZATION_RUNS_VIEW_ID=
#LOTS_VIEW_ID=
# PRINT_QUEUE_WRITE_VIEW_ID is not used by NocoDB v3 PATCH requests.

# ============================================================
# PRINTERS
# ============================================================

# Windows Examples:
#PRINTER_NAME=PDF24
#PRINTER_NAME=JD-268BT_Bluetooth

# Printer for Sterilizer Labels
#STERI_SHEET_PRINTER=Xerox WorkCentre 3215

# macOS / CUPS Examples:
# Run:
#   lpstat -p -d
# to list printers
#
# Example:
# PRINTER_NAME=Zebra_GK420t
# STERI_SHEET_PRINTER=Brother_HL_L2390DW

PRINTER_NAME=PDF24
STERI_SHEET_PRINTER=PDF24

# ============================================================
# LABEL SIZE / PAGE SETUP
# ============================================================

# Windows:
# Preferred if using a Windows printer driver form:
PAPER_FORM_NAME=Label_4x2

# macOS:
# Usually leave PAPER_FORM_NAME blank and use LABEL_* below
# PAPER_FORM_NAME=

LABEL_WIDTH_IN=4
LABEL_HEIGHT_IN=2

ORIENTATION=landscape
FORCE_LANDSCAPE=true

# Optional exact PDF page forcing
FORCE_PAGE_SIZE=false
FORCE_PAGE_WIDTH_PT=288
FORCE_PAGE_HEIGHT_PT=144

# ============================================================
# WINDOWS PRINTING (SumatraPDF)
# ============================================================

# Windows only
USE_SUMATRA=true
SUMATRA_EXE=C:\print-daemon\SumatraPDF.exe
SUMATRA_PRINT_SETTINGS=noscale,landscape

# ============================================================
# macOS / Linux CUPS PRINTING
# ============================================================

# On macOS the daemon uses:
#   lp
#
# Verify media sizes:
#   lpoptions -p YOUR_PRINTER -l
#
# Common examples:
#
# LP_LABEL_OPTIONS=media=Custom.4x2in landscape fit-to-page
# LP_SHEET_OPTIONS=media=Letter portrait fit-to-page

LP_LABEL_OPTIONS=media=Custom.4x2in landscape fit-to-page
LP_SHEET_OPTIONS=media=Letter portrait fit-to-page

# ============================================================
# Timing
# ============================================================

# Delay between prints in ms
PRINT_DRIVER_DELAY=3000

# ============================================================
# Layout
# ============================================================

MARGIN_PT=8
LOGO_WIDTH_PT=140
QR_SIZE_PT=75

# Product_Package_Sample compact-label options
# These labels include the product disclaimer on one 4x2 label.
SAMPLE_COMPANY_INFO_MAX_FONT=7
SAMPLE_COMPANY_ADDRESS_MAX_FONT=6
SAMPLE_COTTAGE_MAX_FONT=6
SAMPLE_TITLE_MAX_FONT=7.5
SAMPLE_SUBTITLE_MAX_FONT=7.5
SAMPLE_META_MAX_FONT=7
SAMPLE_DISCLAIMER_MAX_FONT=6.5
SAMPLE_LOWER_MIN_FONT=3.75
SAMPLE_FOOTER_MAX_FONT=7
SAMPLE_FOOTER_MIN_FONT=5
SAMPLE_FOOTER_RESERVE_PT=11
SAMPLE_LOGO_WIDTH_PT=70
SAMPLE_QR_SIZE_PT=34
SAMPLE_INCLUDE_QR=true

# Page margins in inches (top/right/bottom/left)
LETTER_MARGIN_IN=0.5

# Draw a thin page border for one run to verify sizing
DRAW_PAGE_BORDER=false

# ============================================================
# Paths
# ============================================================

# Where to save generated PDFs
LOG_DIR=./logs
PDF_ARCHIVE_DIR=logs
TEMP_DIR=tmp

# ============================================================
# Notes
# ============================================================

# macOS setup:
#
# 1) Install Node.js
#
# 2) Install dependencies:
#    npm install pdfkit qrcode dotenv axios
#
# 3) Confirm printer names:
#    lpstat -p -d
#
# 4) Confirm media sizes:
#    lpoptions -p YOUR_PRINTER -l
#
# 5) Start daemon:
#    node print-daemon.js --env-file .env
#
# 6) PDFs will be archived under:
#    ./logs/<DAEMON_INSTANCE_ID>/
#