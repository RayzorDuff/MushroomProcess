#DB_BACKEND defaults to Airtable
DB_BACKEND="Airtable"
#DB_BACKEND="NocoDB"

# -----------------------
# Multi-instance settings
# -----------------------
DAEMON_INSTANCE_ID=default

# -----------------------
# Logging / verbosity
# -----------------------
LOG_LEVEL=info
VERBOSE=false

LOG_TO_FILE=true
LOG_FILE=daemon.log
MAX_LOG_BYTES=5242880
MAX_LOG_BACKUPS=5

LOG_TO_CONSOLE=true
LOG_JSON=false

HEARTBEAT_MS=60000

# -----------------------
# Queue routing
# -----------------------
#PRINT_DRY_RUN=true
PRINT_TARGET_FIELD=print_target
#PRINT_TARGET_VALUE=ZEBRA
#PRINT_TARGET_VALUE=TRAYS

#AIRTABLE_EXTRA_FILTER_FORMULA=
#NOCODB_EXTRA_WHERE=

ENABLE_STERI_SHEETS=true

# -----------------------
# Printer locking
# -----------------------
LOCK_DIR=locks
PRINTER_LOCK_TIMEOUT_MS=60000
PRINTER_LOCK_RETRY_MS=250

# -----------------------
# Airtable
# -----------------------
AIRTABLE_API_KEY=pxxxxx
AIRTABLE_BASE_ID=appxxxxxx

# -----------------------
# NocoDB
# -----------------------
#NOCODB_URL=http://localhost:8080
#NOCODB_API_TOKEN=your_token_here

# -----------------------
# Tables
# -----------------------
PRINT_QUEUE_TABLE=print_queue
STERILIZATION_RUNS_TABLE=sterilization_runs
LOTS_TABLE=lots

QUEUE_VIEW=Queue_All

# ============================================================
# PRINTERS
# ============================================================

# Windows Examples:
#PRINTER_NAME=PDF24
#PRINTER_NAME=JD-268BT_Bluetooth
#STERI_SHEET_PRINTER=Xerox WorkCentre 3215

# macOS / CUPS Examples:
# Run:
#   lpstat -p -d
# to list printers
#
# Example:
# PRINTER_NAME=Zebra_GK420t
# STERI_SHEET_PRINTER=Brother_HL_L2390DW

PRINTER_NAME=PDF24
STERI_SHEET_PRINTER=PDF24

# ============================================================
# LABEL SIZE / PAGE SETUP
# ============================================================

# Windows:
# Preferred if using a Windows printer driver form:
PAPER_FORM_NAME=Label_4x2

# macOS:
# Usually leave PAPER_FORM_NAME blank and use LABEL_* below
# PAPER_FORM_NAME=

LABEL_WIDTH_IN=4
LABEL_HEIGHT_IN=2

ORIENTATION=landscape
FORCE_LANDSCAPE=true

# Optional exact PDF page forcing
FORCE_PAGE_SIZE=false
FORCE_PAGE_WIDTH_PT=288
FORCE_PAGE_HEIGHT_PT=144

# ============================================================
# WINDOWS PRINTING (SumatraPDF)
# ============================================================

# Windows only
USE_SUMATRA=true
SUMATRA_EXE=C:\print-daemon\SumatraPDF.exe
SUMATRA_PRINT_SETTINGS=noscale,landscape

# ============================================================
# macOS / Linux CUPS PRINTING
# ============================================================

# On macOS the daemon uses:
#   lp
#
# Verify media sizes:
#   lpoptions -p YOUR_PRINTER -l
#
# Common examples:
#
# LP_LABEL_OPTIONS=media=Custom.4x2in landscape fit-to-page
# LP_SHEET_OPTIONS=media=Letter portrait fit-to-page

LP_LABEL_OPTIONS=media=Custom.4x2in landscape fit-to-page
LP_SHEET_OPTIONS=media=Letter portrait fit-to-page

# ============================================================
# Timing
# ============================================================

PRINT_DRIVER_DELAY=3000

# ============================================================
# Layout
# ============================================================

MARGIN_PT=8
LOGO_WIDTH_PT=140
QR_SIZE_PT=75

LETTER_MARGIN_IN=0.5

DRAW_PAGE_BORDER=false

# ============================================================
# Paths
# ============================================================

LOG_DIR=./logs
PDF_ARCHIVE_DIR=logs
TEMP_DIR=tmp

# ============================================================
# Notes
# ============================================================

# macOS setup:
#
# 1) Install Node.js
#
# 2) Install dependencies:
#    npm install pdfkit qrcode dotenv axios
#
# 3) Confirm printer names:
#    lpstat -p -d
#
# 4) Confirm media sizes:
#    lpoptions -p YOUR_PRINTER -l
#
# 5) Start daemon:
#    node print-daemon.js --env-file .env
#
# 6) PDFs will be archived under:
#    ./logs/<DAEMON_INSTANCE_ID>/
#
